  },
  "devDependencies": {
    "@cf-wasm/og": "^0.5.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
