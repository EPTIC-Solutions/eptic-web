/**
 * One Worker serves every EPTIC hostname. Host -> site mapping and redirects
 * live in app/sites.ts.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eptic-web",
  "compatibility_date": "2026-11-04",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // Static files (incl. pre-rendered banners) are readable from the Worker as env.ASSETS.
  "assets": { "binding": "ASSETS" },
  // Keeps the <name>.<account>.workers.dev URL for testing before DNS cutover.
  "workers_dev": true,
  /**
   * Worker Routes: the Worker answers requests on these hostnames before they
   * reach the origin. Each hostname needs a *proxied* (orange cloud) DNS record;
   * its target IP is never contacted while the route exists.
   * Cutover is one host at a time; uncomment each as it moves off Hetzner.
   * Rollback for a host = comment it out and redeploy.
   */
  "routes": [
    { "pattern": "banners.eptic.ro/*", "zone_name": "eptic.ro" },
    // { "pattern": "start.eptic.ro/*", "zone_name": "eptic.ro" },
    // { "pattern": "www.eptic.ro/*", "zone_name": "eptic.ro" },
    // { "pattern": "eptic.ro/*", "zone_name": "eptic.ro" },
    // { "pattern": "terminal.eptic.ro/*", "zone_name": "eptic.ro" },
    // { "pattern": "epticgames.com/*", "zone_name": "epticgames.com" },
    // { "pattern": "www.epticgames.com/*", "zone_name": "epticgames.com" },
  ],
  /**
   * Secrets (not committed):
   *   wrangler secret put GITHUB_TOKEN   # optional, avoids GitHub API rate limits for `repos`
   */
}
